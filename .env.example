# Get these from your Supabase project: Settings -> API
# Use the SAME project as your al-nawras CMS admin panel so content
# managed there (Products, Projects, Team, Certifications, etc.)
# actually shows up on this site.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
